<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Archlinux on artyvr.ru</title><link>https://artyvr.ru/tags/archlinux/</link><description>Recent content in Archlinux on artyvr.ru</description><generator>Hugo</generator><language>ru-ru</language><lastBuildDate>Sun, 29 Jun 2025 18:00:00 +0100</lastBuildDate><atom:link href="https://artyvr.ru/tags/archlinux/index.xml" rel="self" type="application/rss+xml"/><item><title>Установка archlinux</title><link>https://artyvr.ru/posts/archlinux_install/</link><pubDate>Sun, 29 Jun 2025 18:00:00 +0100</pubDate><guid>https://artyvr.ru/posts/archlinux_install/</guid><description>&lt;h3 id="при-ошибке-синхранизации-времени-time-synchronization-not-completing-while-you-wait-check-the-docs-for-workarounds">При ошибке синхранизации времени (time synchronization not completing while you wait check the docs for workarounds)&lt;/h3>
&lt;p>Проблема актуальна на 30 июня 2026 г.&lt;/p>
&lt;div class="highlight">&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-bash" data-lang="bash">&lt;span style="display:flex;">&lt;span>nano /etc/systemd/timesyncd.conf
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;p>Дописываем&lt;/p>
&lt;div class="highlight">&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-bash" data-lang="bash">&lt;span style="display:flex;">&lt;span>NTP&lt;span style="color:#f92672">=&lt;/span>time.google.com
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;p>Раскомментируем &lt;strong>Fallback_NTP&lt;/strong>
Сохраняем файл&lt;/p>
&lt;div class="highlight">&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-bash" data-lang="bash">&lt;span style="display:flex;">&lt;span>systemctl restart systemd-timesyncd
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div></description></item></channel></rss>